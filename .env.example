# Califnco Water App - Environment Configuration Template
# Copy this file to .env and insert your Razorpay test mode credentials.

# Razorpay TEST MODE Public Key (Must start with 'rzp_test_')
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE

# Razorpay TEST MODE Secret Key (Used strictly for server-side verification; never in client code)
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# n8n Instagram Reels Automation Webhook Endpoint (Secure Trigger URL)
EXPO_PUBLIC_N8N_REELS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/califnco-reels-trigger

# n8n Webhook Bearer Authentication Token (Optional - if webhook requires auth header)
EXPO_PUBLIC_N8N_WEBHOOK_AUTH_TOKEN=your_secure_bearer_token_here