{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/customer/orders/:id",
      "destination": "/customer/orders/[id].html"
    },
    {
      "source": "/admin/reels",
      "destination": "/admin/reels.html"
    },
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
